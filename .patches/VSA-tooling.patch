+# Docs build — TEv2 + MkDocs smoke bij PR (geen Pages-deploy).
+# Op push dekt docs-pages.yml dezelfde build; dubbele runs vermijden.
+# Deploy van docs: docs-pages.yml. Lokaal: scripts\docs-build-tev2.cmd
+
+name: Docs build
+
+on:
+  pull_request:
+  workflow_dispatch:
+
+concurrency:
+  group: docs-build-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  docs-build:
+    name: TEv2 + MkDocs --strict
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Setup Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.14"
+          cache: pip
+          cache-dependency-path: requirements-docs.txt
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+          cache: npm
+
+      - name: Install documentation dependencies
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install -r requirements-docs.txt
+
+      - name: Install terminology tools
+        run: npm ci
+
+      - name: Prepare TEv2 docs staging tree
+        run: python scripts/prepare-tev2-docs.py
+
+      - name: Run terminology tools
+        run: |
+          export PATH="$PWD/node_modules/.bin:$PATH"
+          cd generated/docs
+          mrg-import -c tev2-config.yaml
+          mrgt       -c tev2-config.yaml
+          hrgt -f    -c tev2-config.yaml
+          python ../../scripts/sort-glossary-table.py glossary.md
+          python ../../scripts/inject-glossary-termrefs.py glossary.md
+          trrt -f    -c tev2-config.yaml
+
+      - name: Verify TermRefs resolved
+        run: python scripts/check-tev2-termrefs.py generated/docs
+
+      - name: Build MkDocs site
+        env:
+          NO_MKDOCS_2_WARNING: "1"
+        run: python -m mkdocs build --strict -f generated/mkdocs.yml --site-dir ../site
